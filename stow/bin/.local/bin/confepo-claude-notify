#!/usr/bin/env bash
# confepo-claude-notify {attention|clear} — Claude Code hook helper.
#
# Wired into ~/.claude/settings.json by `setup_claude_hooks` (lib/common.sh):
#   Notification      -> attention   (Claude needs input / a permission)
#   UserPromptSubmit  -> clear       (you replied, so it's handled)
#   SessionEnd        -> clear       (terminal/session closed)
#
# It reads the hook JSON from stdin, pulls out the session_id, and sets/clears a
# per-session flag file. The i3blocks `claude_status` block counts those flags
# to show whether any Claude terminal is waiting for you. Must exit 0 so it
# never blocks Claude.
set -euo pipefail

# Make sibling helpers (confepo-notify-phone) resolvable even in a minimal env.
export PATH="$HOME/.local/bin:$PATH"

action="${1:-}"
dir="${XDG_CACHE_HOME:-$HOME/.cache}/confepo/claude/attention"
mkdir -p "$dir"

payload="$(cat 2>/dev/null || true)"

jqget() { printf '%s' "$payload" | jq -r "$1 // empty" 2>/dev/null || true; }

# session_id via jq when available, else a tolerant sed fallback.
sid=""
command -v jq >/dev/null 2>&1 && sid="$(jqget '.session_id')"
[ -n "$sid" ] || sid="$(printf '%s' "$payload" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
[ -n "$sid" ] || sid="unknown"
# Guard against path tricks — keep only filename-safe characters.
sid="$(printf '%s' "$sid" | tr -c 'A-Za-z0-9._-' '_')"

cwd="$(jqget '.cwd')"

case "$action" in
  attention)
    # Record which tmux pane this session lives in (empty if not under tmux) so
    # the Phase-2 phone bridge knows where to inject a reply. The i3blocks block
    # only counts these files, so the contents are free for our use.
    { printf 'pane=%s\n' "${TMUX_PANE:-}"; printf 'cwd=%s\n' "$cwd"; } > "$dir/$sid"
    ;;
  clear) rm -f "$dir/$sid" ;;
  *)     echo "usage: confepo-claude-notify {attention|clear}" >&2; exit 2 ;;
esac

# Nudge the i3blocks claude block (signal 12) to refresh immediately.
pkill -RTMIN+12 i3blocks 2>/dev/null || true

# On attention, also push to your phone — a no-op unless `confepo remote setup`
# has been run. Detached in a subshell so the hook returns immediately.
#
# DISCLOSURE POLICY: send a generic status ONLY. We deliberately do NOT pass
# Claude's notification text (.message), the cwd, or the project name — those
# would leak what you're working on over Telegram. confepo-notify-phone also
# sanitises as a backstop. Keep this vague.
if [ "$action" = attention ] && command -v confepo-notify-phone >/dev/null 2>&1; then
  ( confepo-notify-phone "needs your attention" >/dev/null 2>&1 & )
fi
exit 0
