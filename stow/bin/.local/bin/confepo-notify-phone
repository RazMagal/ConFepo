#!/usr/bin/env bash
# confepo-notify-phone [-t TITLE] MESSAGE… — push a SHORT, VAGUE status to your
# phone via Telegram. Reads ~/.config/confepo/notify.conf:
#     TELEGRAM_BOT_TOKEN="123456:ABC…"
#     TELEGRAM_CHAT_ID="987654321"
#     CONFEPO_NOTIFY_LABEL="workstation"   # optional machine label; set "" to omit
#
# DISCLOSURE POLICY (hard rule). Messages transit Telegram's servers in
# plaintext, so we never send work details. sanitize() below is a deterministic
# backstop that strips paths, code, URLs and long tokens and hard-caps the
# length — but callers must ALSO keep messages generic ("needs your input", not
# file/command specifics). See the disclosure rule in ~/.claude/CLAUDE.md.
#
# Silent no-op when unconfigured; short timeout; always exits 0 (never blocks a
# hook).
set -euo pipefail

conf="${XDG_CONFIG_HOME:-$HOME/.config}/confepo/notify.conf"
[ -f "$conf" ] || exit 0
# shellcheck source=/dev/null
. "$conf"
[ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ] || exit 0
command -v curl >/dev/null 2>&1 || exit 0

# Deterministic "no disclosure" scrub for anything that leaves this machine.
sanitize() {
  printf '%s' "$*" | sed -E '
    s/`+//g;
    s#https?://[^[:space:]]+#[link]#g;
    s#~?(/[[:alnum:]._-]+){2,}/?#[path]#g;
    s#[[:alnum:]+/=_-]{20,}#[redacted]#g;
    s/[[:cntrl:]]+/ /g;
    s/[[:space:]]+/ /g;
    s/^ //; s/ $//' | cut -c1-140
}

title=""
if [ "${1:-}" = "-t" ]; then title="${2:-}"; shift 2 || true; fi
body="$(sanitize "${*:-}")"
[ -n "$body" ] || body="needs your attention"

# Label lets you know which machine; unset -> short hostname, "" -> omit.
label="${CONFEPO_NOTIFY_LABEL-$(hostname -s 2>/dev/null || echo pc)}"
head="$(sanitize "${title:-🤖 Claude}${label:+ · $label}")"
msg="${head}"$'\n'"${body}"

# The token-bearing URL goes to curl via --config on stdin, never argv:
# anything in argv is world-readable in /proc/*/cmdline for the whole request.
printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TELEGRAM_BOT_TOKEN" \
  | curl -fsS --max-time 8 --config - \
      --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
      --data-urlencode "text=${msg}" \
      -o /dev/null 2>/dev/null || true
exit 0
