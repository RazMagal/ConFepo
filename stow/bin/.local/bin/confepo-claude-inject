#!/usr/bin/env bash
# confepo-claude-inject <tmux-pane> [--no-enter] — read one message on stdin and
# type it into the given tmux pane (as if you typed it, then Enter). This is the
# mechanism the Phase-2 phone bridge uses to deliver your replies and
# menu/permission choices into a running Claude Code TUI.
#
# Safety: it only ever targets a tmux pane you named (recorded by the attention
# hook), verifies the pane exists first, and sends the text literally (-l) so no
# key names are interpreted. Embedded newlines are flattened to spaces — inside
# the TUI each literal newline IS an Enter keypress, so a multi-line message
# would blind-submit whatever prompts come after the first line. The bridge
# authorises the sender BEFORE calling this.
set -euo pipefail

pane="${1:-}"
[ -n "$pane" ] || { echo "usage: confepo-claude-inject <tmux-pane> [--no-enter]" >&2; exit 2; }
enter=1
[ "${2:-}" = "--no-enter" ] && enter=0

command -v tmux >/dev/null 2>&1 || { echo "confepo-claude-inject: tmux not found" >&2; exit 3; }
tmux has-session >/dev/null 2>&1 || { echo "confepo-claude-inject: no tmux server running" >&2; exit 4; }
tmux list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fxq "$pane" \
  || { echo "confepo-claude-inject: pane '$pane' not found" >&2; exit 5; }

text="$(cat)"
# One message = one submission: strip CRs, flatten newlines to spaces. Never
# let send-keys -l type a literal \n — the TUI treats each one as Enter.
text="${text//$'\r'/}"
text="${text//$'\n'/ }"
tmux send-keys -t "$pane" -l -- "$text"
[ "$enter" = 1 ] && tmux send-keys -t "$pane" Enter
exit 0
