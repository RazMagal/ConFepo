#!/usr/bin/env bash
# confepo-crypt {encrypt|decrypt} — authenticated symmetric encryption for the
# phone channel, so Telegram (or anything on the wire) only ever carries
# ciphertext. AES-256-GCM via Node's standard library — no npm packages.
#
#   echo "hi" | confepo-crypt encrypt   ->  cfp1:<base64>
#   echo "cfp1:…" | confepo-crypt decrypt  ->  hi
#
# Key: CONFEPO_NOTIFY_KEY (base64 of 32 random bytes), read from the environment
# or ~/.config/confepo/notify.conf. Wire format = base64( iv[12] || tag[16] ||
# ciphertext ), prefixed "cfp1:" so the scheme can evolve. GCM's 16-byte tag is
# verified on decrypt, so tampered ciphertext is rejected (it can't be used to
# inject forged instructions).
set -euo pipefail

mode="${1:-}"
case "$mode" in
  encrypt|decrypt) ;;
  *) echo "usage: confepo-crypt {encrypt|decrypt}" >&2; exit 2 ;;
esac

# Resolve node even in a minimal hook env (fnm doesn't export PATH to hooks).
node_bin="$(command -v node 2>/dev/null || true)"
[ -n "$node_bin" ] || node_bin="${FNM_DIR:-$HOME/.local/share/fnm}/aliases/default/bin/node"
[ -x "$node_bin" ] || { echo "confepo-crypt: node not found (needed for encryption)" >&2; exit 3; }

# Load the key from config if it isn't already exported.
if [ -z "${CONFEPO_NOTIFY_KEY:-}" ]; then
  conf="${XDG_CONFIG_HOME:-$HOME/.config}/confepo/notify.conf"
  # shellcheck source=/dev/null
  [ -f "$conf" ] && . "$conf"
fi
[ -n "${CONFEPO_NOTIFY_KEY:-}" ] || { echo "confepo-crypt: no CONFEPO_NOTIFY_KEY (run: confepo remote setup)" >&2; exit 4; }

CFP_MODE="$mode" CONFEPO_NOTIFY_KEY="$CONFEPO_NOTIFY_KEY" exec "$node_bin" -e '
const crypto = require("crypto");
const mode = process.env.CFP_MODE;
const key = Buffer.from(process.env.CONFEPO_NOTIFY_KEY, "base64");
if (key.length !== 32) { process.stderr.write("confepo-crypt: key must be 32 bytes (base64)\n"); process.exit(5); }
const chunks = [];
process.stdin.on("data", d => chunks.push(d));
process.stdin.on("end", () => {
  try {
    const input = Buffer.concat(chunks);
    if (mode === "encrypt") {
      const iv = crypto.randomBytes(12);
      const c = crypto.createCipheriv("aes-256-gcm", key, iv);
      const ct = Buffer.concat([c.update(input), c.final()]);
      process.stdout.write("cfp1:" + Buffer.concat([iv, c.getAuthTag(), ct]).toString("base64") + "\n");
    } else {
      let s = input.toString("utf8").trim();
      if (s.startsWith("cfp1:")) s = s.slice(5);
      const raw = Buffer.from(s, "base64");
      if (raw.length < 28) throw new Error("ciphertext too short");
      const iv = raw.subarray(0, 12), tag = raw.subarray(12, 28), ct = raw.subarray(28);
      const d = crypto.createDecipheriv("aes-256-gcm", key, iv);
      d.setAuthTag(tag);
      process.stdout.write(Buffer.concat([d.update(ct), d.final()]));
    }
  } catch (e) {
    process.stderr.write("confepo-crypt: " + (e && e.message ? e.message : e) + "\n");
    process.exit(6);
  }
});
'
