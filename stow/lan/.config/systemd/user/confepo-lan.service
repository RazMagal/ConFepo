[Unit]
Description=confepo LAN phone-notification server (pure local, no cloud)
Documentation=https://github.com/RazMagal/ConFepo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The server reads ~/.config/confepo/lan.conf itself (env vars would also win).
ExecStart=%h/.local/lib/confepo/confepo-lan-server
Restart=on-failure
RestartSec=2
# Light hardening — it only needs to open a socket and read its own config.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# Bound the blast radius of any request-buffering bug: if the server misbehaves
# it OOMs alone instead of pushing the kernel to pick a victim in your session.
MemoryMax=128M
TasksMax=64

# NO [Install] SECTION — deliberately.
#
# This opens a listening socket on your LAN, so it must never come up on its
# own. Without an [Install] section `systemctl --user enable` fails outright,
# which means the service can only ever be running because someone ran
# `confepo lan start` in this session. It dies at logout/reboot and stays dead
# until asked again. That's the guarantee; don't add WantedBy= to "fix" it.
