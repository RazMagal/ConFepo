#!/usr/bin/env python3
"""confepo-lan-server — pure-LAN phone notification server.

Runs on your laptop and serves a tiny web page your phone (ANY OS — it's just a
browser) opens on the same Wi-Fi. When Claude Code needs you, `confepo-notify-lan`
POSTs a status here and this server pushes it to every connected phone over
Server-Sent Events (instant banner + chime + vibrate).

Nothing ever leaves your LAN: no cloud, no Telegram, no APNs. Your IP is only
reachable by devices already on your own network. Because it's local-only it's
safe to include real detail (unlike the deliberately-vague Telegram path).

Limitation (an iOS/browser fact, not ours): a locked/backgrounded phone can only
be woken by a cloud push service. This delivers instantly while the page is open
— use the in-page "Keep screen awake" toggle so alerts always land.

Phase 2 — replying from the phone: alerts carry the Claude session id (sid),
and POST /reply {sid, text} types the text into that session's tmux pane via
confepo-claude-inject. The pane is looked up server-side from the attention
flag file the notify hook wrote — the client can only NAME a session, never
choose a pane — and the inject helper itself flattens newlines so one reply is
always exactly one submission.

Config: ~/.config/confepo/lan.conf  (KEY="value" lines; matching env vars win)
  CONFEPO_LAN_PORT    default 8787
  CONFEPO_LAN_BIND    default 0.0.0.0  (all interfaces, so the phone can reach it)
  CONFEPO_LAN_TOKEN   shared secret; /events, /notify and /reply require ?t=TOKEN
Test seams (env only, not in lan.conf):
  CONFEPO_ATTENTION_DIR  where the per-session pane= flag files live
                         (default ~/.cache/confepo/claude/attention)
  CONFEPO_INJECT_BIN     path to confepo-claude-inject (default ~/.local/bin/…)
"""

import json
import os
import queue
import re
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

CONF = {}
_clients = set()
_clients_lock = threading.Lock()

# A /notify payload is a title + a short body; 8 KiB is generous. Anything
# bigger is a mistake or an attack — reject before buffering it in RAM.
MAX_BODY = 8192

# A phone reply is a menu choice or a short sentence. Longer input is rejected
# outright (never silently truncated — half a command must not reach the TUI).
MAX_REPLY = 500

# Session ids as written by confepo-claude-notify (already tr'd to this set);
# pane ids as tmux prints them (%0, %12, …). Anything else is refused.
SID_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
PANE_RE = re.compile(r"^%[0-9]+$")


def attention_dir():
    return os.environ.get("CONFEPO_ATTENTION_DIR") or os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
        "confepo", "claude", "attention",
    )


def pane_for_sid(sid):
    """The flag file for sid, parsed. None = no such session; "" = session
    exists but wasn't running under tmux (nothing to inject into)."""
    try:
        with open(os.path.join(attention_dir(), sid), encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("pane="):
                    return line[len("pane="):].strip()
    except OSError:
        return None
    return ""


def load_conf():
    """Read lan.conf (tolerant KEY=VALUE parser); env vars override the file."""
    path = os.environ.get("CONFEPO_LAN_CONF") or os.path.expanduser(
        "~/.config/confepo/lan.conf"
    )
    vals = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                vals[key.strip()] = val.strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    for key in ("CONFEPO_LAN_PORT", "CONFEPO_LAN_BIND", "CONFEPO_LAN_TOKEN"):
        if os.environ.get(key):
            vals[key] = os.environ[key]
    return vals


def broadcast(obj):
    data = json.dumps(obj)
    with _clients_lock:
        targets = list(_clients)
    for client in targets:
        try:
            client.put_nowait(data)
        except queue.Full:
            pass


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    # Socket timeout (BaseHTTPRequestHandler honours it): without one, a peer
    # that opens a connection and goes silent parks a thread + fd forever —
    # a handful of half-open sockets from anything on the Wi-Fi would starve
    # the server (ThreadingHTTPServer has no thread cap). SSE streams are fine:
    # the 15 s heartbeat writes keep them well inside this window.
    timeout = 30

    # Quiet — journald already timestamps; we don't want a line per SSE poll.
    def log_message(self, *_args):
        pass

    def _auth_ok(self, qs):
        want = CONF.get("CONFEPO_LAN_TOKEN", "")
        if not want:
            return False
        return qs.get("t", [""])[0] == want

    def _send(self, code, ctype, body):
        raw = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        if raw:
            self.wfile.write(raw)

    def do_GET(self):
        route = urlparse(self.path)
        qs = parse_qs(route.query)
        if route.path == "/":
            self._send(200, "text/html; charset=utf-8", PAGE)
        elif route.path == "/manifest.webmanifest":
            self._send(200, "application/manifest+json", MANIFEST)
        elif route.path == "/sw.js":
            self._send(200, "application/javascript", SW_JS)
        elif route.path == "/healthz":
            self._send(200, "text/plain", "ok")
        elif route.path == "/events":
            if not self._auth_ok(qs):
                self._send(403, "text/plain", "forbidden")
                return
            self._stream()
        else:
            self._send(404, "text/plain", "not found")

    def _read_json(self):
        """Read + parse a capped JSON request body; returns a dict, or None
        after having already sent the error response."""
        try:
            length = int(self.headers.get("Content-Length", "0") or 0)
        except ValueError:
            self._send(400, "text/plain", "bad content-length")
            return None
        if length < 0:  # rfile.read(-1) would block reading until EOF
            self._send(400, "text/plain", "bad content-length")
            return None
        if length > MAX_BODY:
            self._send(413, "text/plain", "payload too large")
            return None
        raw = self.rfile.read(length) if length else b""
        try:
            obj = json.loads(raw.decode("utf-8")) if raw else {}
        except (ValueError, UnicodeDecodeError):
            obj = {}
        if not isinstance(obj, dict):  # a JSON list/scalar has no .get()
            obj = {}
        return obj

    def do_POST(self):
        route = urlparse(self.path)
        qs = parse_qs(route.query)
        if route.path not in ("/notify", "/reply"):
            self._send(404, "text/plain", "not found")
            return
        if not self._auth_ok(qs):
            self._send(403, "text/plain", "forbidden")
            return
        obj = self._read_json()
        if obj is None:
            return
        if route.path == "/notify":
            self._notify(obj)
        else:
            self._reply(obj)

    def _notify(self, obj):
        # sid rides along so the phone knows which session a reply targets.
        # Validated here too: it becomes a filename component in /reply.
        sid = str(obj.get("sid", ""))
        if not SID_RE.match(sid):
            sid = ""
        broadcast(
            {
                "title": str(obj.get("title", "Claude needs you"))[:120],
                "body": str(obj.get("body", ""))[:400],
                "sid": sid,
                "ts": time.time(),
            }
        )
        self._send(204, "text/plain", "")

    def _reply(self, obj):
        """Type a phone reply into the session's tmux pane.

        The client only names a SESSION; the pane comes from the flag file the
        notify hook wrote, so a phone (even with the token) can never point the
        injection at an arbitrary pane. SID_RE keeps the sid a safe single
        filename component (no separators, no dots-only names)."""
        sid = str(obj.get("sid", ""))
        text = str(obj.get("text", ""))
        if not SID_RE.match(sid):
            self._send(400, "text/plain", "bad sid")
            return
        if not text.strip():
            self._send(400, "text/plain", "empty reply")
            return
        if len(text) > MAX_REPLY:
            self._send(413, "text/plain", "reply too long")
            return
        pane = pane_for_sid(sid)
        if pane is None:
            self._send(404, "text/plain", "no such session (it may have been answered already)")
            return
        if not PANE_RE.match(pane):
            self._send(409, "text/plain", "session is not in a tmux pane — reply at the keyboard")
            return
        inject = os.environ.get("CONFEPO_INJECT_BIN") or os.path.expanduser(
            "~/.local/bin/confepo-claude-inject"
        )
        try:
            res = subprocess.run(
                [inject, pane],
                input=text.encode("utf-8"),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired):
            self._send(502, "text/plain", "inject helper failed")
            return
        if res.returncode != 0:
            self._send(502, "text/plain", "inject helper failed")
            return
        self._send(204, "text/plain", "")

    def _stream(self):
        client = queue.Queue(maxsize=64)
        with _clients_lock:
            _clients.add(client)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.send_header("X-Accel-Buffering", "no")
        self.end_headers()
        try:
            # Greet immediately so the page flips to "connected".
            self._sse(
                {
                    "kind": "status",
                    "title": "Connected",
                    "body": "Waiting — you'll get an alert when Claude needs you.",
                    "ts": time.time(),
                }
            )
            while True:
                try:
                    data = client.get(timeout=15)
                    self.wfile.write(b"data: " + data.encode("utf-8") + b"\n\n")
                    self.wfile.flush()
                except queue.Empty:
                    # Heartbeat keeps NAT/router idle timeouts from dropping us
                    # and surfaces a dead client as a write error.
                    self.wfile.write(b": ping\n\n")
                    self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            with _clients_lock:
                _clients.discard(client)

    def _sse(self, obj):
        self.wfile.write(b"data: " + json.dumps(obj).encode("utf-8") + b"\n\n")
        self.wfile.flush()


MANIFEST = json.dumps(
    {
        "name": "confepo alerts",
        "short_name": "confepo",
        "display": "standalone",
        "background_color": "#1e1e2e",
        "theme_color": "#1e1e2e",
        "start_url": "./",
        "scope": "./",
    }
)

# Minimal service worker — just enough for iOS "Add to Home Screen" to treat the
# page as an installable standalone app. No offline caching, no push (pure LAN).
SW_JS = "self.addEventListener('install',()=>self.skipWaiting());\n" \
        "self.addEventListener('activate',e=>e.waitUntil(self.clients.claim()));\n"

PAGE = r"""<!doctype html>
