"""


def main():
    global CONF
    CONF = load_conf()
    try:
        port = int(CONF.get("CONFEPO_LAN_PORT", "8787"))
    except ValueError:
        port = 8787
    bind = CONF.get("CONFEPO_LAN_BIND", "0.0.0.0")
    httpd = ThreadingHTTPServer((bind, port), Handler)
    httpd.daemon_threads = True
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
