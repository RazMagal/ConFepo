<script>
(function(){
  var token = new URLSearchParams(location.search).get("t") || "";
  var dot=document.getElementById("dot"), st=document.getElementById("st");
  var live=document.getElementById("live"), log=document.getElementById("log");
  var armBtn=document.getElementById("arm"), wakeBox=document.getElementById("wake"), wakeSt=document.getElementById("wakest");
  var replyBox=document.getElementById("reply"), rtext=document.getElementById("rtext");
  var rsend=document.getElementById("rsend"), rstatus=document.getElementById("rstatus");
  var actx=null, wakeLock=null, armed=false, replySid=null;

  function sendReply(t){
    t=(t||"").trim();
    if(!replySid || !t) return;
    rstatus.textContent="sending…";
    fetch("/reply?t="+encodeURIComponent(token),{method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({sid:replySid,text:t})})
    .then(function(r){
      if(r.status===204){ rstatus.textContent="sent ✓"; rtext.value=""; live.className=""; }
      else{ return r.text().then(function(b){ rstatus.textContent="failed: "+(b||("HTTP "+r.status)); }); }
    })
    .catch(function(){ rstatus.textContent="failed: network error"; });
  }
  rsend.addEventListener("click",function(){ sendReply(rtext.value); });
  rtext.addEventListener("keydown",function(e){ if(e.key==="Enter") sendReply(rtext.value); });
  Array.prototype.forEach.call(document.querySelectorAll("#reply [data-q]"),function(b){
    b.addEventListener("click",function(){ sendReply(b.getAttribute("data-q")); });
  });

  function setStatus(on){ dot.classList.toggle("on",on); st.textContent = on ? "connected" : "reconnecting…"; }

  function arm(){
    try{ actx = actx || new (window.AudioContext||window.webkitAudioContext)(); actx.resume(); }catch(e){}
    try{ if("Notification" in window && Notification.permission==="default") Notification.requestPermission(); }catch(e){}
    armed=true; armBtn.textContent="Alerts armed ✓"; armBtn.classList.add("armed");
    if(wakeBox.checked) requestWake();
  }
  armBtn.addEventListener("click", arm);

  function beep(){
    if(!actx) return;
    var now=actx.currentTime;
    [880,660,990].forEach(function(f,i){
      var o=actx.createOscillator(), g=actx.createGain();
      o.type="sine"; o.frequency.value=f; o.connect(g); g.connect(actx.destination);
      var t=now+i*0.2;
      g.gain.setValueAtTime(0.0001,t);
      g.gain.exponentialRampToValueAtTime(0.6,t+0.03);
      g.gain.exponentialRampToValueAtTime(0.0001,t+0.18);
      o.start(t); o.stop(t+0.2);
    });
  }

  async function requestWake(){
    try{
      if("wakeLock" in navigator){ wakeLock = await navigator.wakeLock.request("screen");
        wakeSt.textContent="on"; wakeLock.addEventListener("release",function(){wakeSt.textContent="";}); }
      else { wakeSt.textContent="unsupported"; }
    }catch(e){ wakeSt.textContent="blocked"; }
  }
  wakeBox.addEventListener("change", function(){ if(wakeBox.checked) requestWake(); else if(wakeLock){wakeLock.release(); wakeLock=null; wakeSt.textContent="";} });
  document.addEventListener("visibilitychange", function(){ if(document.visibilityState==="visible" && wakeBox.checked) requestWake(); });

  function pad(n){ return (n<10?"0":"")+n; }
  function fmt(ts){ var d=new Date(ts*1000); return pad(d.getHours())+":"+pad(d.getMinutes()); }

  function fire(m){
    live.className="alert";
    live.innerHTML='<div class="big"></div><div class="sub"></div>';
    live.querySelector(".big").textContent = m.title || "Claude needs you";
    live.querySelector(".sub").textContent  = m.body || "";
    if(m.sid){ replySid=m.sid; replyBox.style.display=""; rstatus.textContent=""; }
    else     { replySid=null;  replyBox.style.display="none"; }
    beep();
    try{ if(navigator.vibrate) navigator.vibrate([200,100,200,100,400]); }catch(e){}
    try{ if("Notification" in window && Notification.permission==="granted") new Notification(m.title||"Claude", {body:m.body||"", tag:"confepo"}); }catch(e){}
    var li=document.createElement("li");
    li.innerHTML='<div class="t"></div><div class="m"></div><time></time>';
    li.querySelector(".t").textContent=m.title||"Claude needs you";
    li.querySelector(".m").textContent=m.body||"";
    li.querySelector("time").textContent=fmt(m.ts||Date.now()/1000);
    log.insertBefore(li, log.firstChild);
    while(log.children.length>25) log.removeChild(log.lastChild);
  }

